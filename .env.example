# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# Supabase project (create a dedicated project for this engine)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-or-anon-key

# Embedding model (optional; defaults to BAAI/bge-m3, 1024-dim)
EMBEDDING_MODEL=BAAI/bge-m3
