# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# Supabase project. You can reuse an existing project — the engine lives in its
# own `semantic_search` schema (see db/schema.sql), isolated from your app's
# public tables. Use the SERVICE-ROLE key for indexing (bypasses RLS).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key

# Schema the engine's tables live in (optional; defaults to semantic_search)
SUPABASE_SCHEMA=semantic_search

# Embedding model (optional; defaults to BAAI/bge-m3, 1024-dim)
EMBEDDING_MODEL=BAAI/bge-m3

# Embedding backend: "sentence_transformers" (default, local/GPU) or
# "workers_ai" (Cloudflare Workers AI REST — the $0 deploy path).
EMBEDDING_BACKEND=sentence_transformers

# Needed only when EMBEDDING_BACKEND=workers_ai
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# WORKERS_AI_MODEL=@cf/baai/bge-m3
